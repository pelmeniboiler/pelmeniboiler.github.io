{
  "name": "pelmeniboiler-site",
  "version": "0.1.0",
  "private": true,
  "description": "Build tooling for the Pelmeniboiler static site. Sources in the repo, built site in /_site.",
  "type": "module",
  "scripts": {
    "build": "node build/build.mjs",
    "test": "node test/site.test.mjs",
    "lint:gt": "node build/validate-gt.mjs",
    "check:links": "node build/check-links.mjs",
    "tl:status": "node build/tl.mjs status",
    "tl:stamp": "node build/tl.mjs stamp",
    "icons": "node build/generate-icons.mjs",
    "fonts": "python3 build/fonts.py && python3 build/font-slices.py",
    "cursors": "node build/generate-cursors.mjs",
    "tl:auto": "node build/tl-auto.mjs",
    "vault:check": "node build/vault-check.mjs",
    "gt:eval": "node build/gt-eval.mjs",
    "preview": "python3 -m http.server 8000 --directory _site",
    "clean": "rm -rf _site"
  },
  "dependencies": {
    "fontkit": "^2.0.4",
    "jsdom": "^24.0.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
