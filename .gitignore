Pelmeni Raster.fon
.agent/

# Node build tooling
node_modules/

# The built site: everything `npm run build` produces (`npm run preview` serves it)
/_site/

# Output of the old in-place build, in case any is still lying around
/sitemap.xml
blog/*/

# Generated feeds + manifest (built fresh in CI)
/rss/
/blog/blog-manifest.json
/zine/

# Generated photo variants (AVIF/WebP/e-ink; `npm run images`, cached in CI)
/img/

# Generated emoji sprite/map/coverage (build/emoji.mjs)
/styles/emoji/

# Gap-filler font sources (build/fonts.py downloads them; only subsets are committed)
/styles/fonts/_sources/
__pycache__/
*.pt
/runs/
